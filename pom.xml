<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.silentdevelopment.atlas</groupId>
    <artifactId>atlas</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <modules>
        <module>atlas-api</module>
        <module>atlas-core</module>
        <module>atlas-bind</module>
        <module>atlas-io</module>
        <module>atlas-codecs</module>
    </modules>

    <name>Atlas</name>
    <description>Config management library</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>thesilentpro</id>
            <name>TheSilentPro</name>
            <url>https://github.com/TheSilentPro</url>
            <organization>SilentDevelopment</organization>
            <organizationUrl>https://github.com/SilentDevelopment</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/silentdevelopment/atlas.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/silentdevelopment/atlas.git</developerConnection>
        <url>https://github.com/silentdevelopment/atlas</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <snakeyaml.version>2.3</snakeyaml.version>
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.silentdevelopment.atlas</groupId>
                <artifactId>atlas-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.silentdevelopment.atlas</groupId>
                <artifactId>atlas-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.silentdevelopment.atlas</groupId>
                <artifactId>atlas-io-standard</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.silentdevelopment.atlas</groupId>
                <artifactId>atlas-codec-yaml</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.silentdevelopment.atlas</groupId>
                <artifactId>atlas-bind</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
